{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marcelonicchio-now-playing",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "SPOTIFY_STATE"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://marcelonicchio.com"
  },
  "secrets": {
    "required": [
      "SPOTIFY_CLIENT_ID",
      "SPOTIFY_CLIENT_SECRET",
      "ADMIN_KEY",
      "STATE_SECRET"
    ]
  }
}
